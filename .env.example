# Copy to `.env` in this directory before running agents or evaluations.
#
# Recommended split for main inference / golden eval:
# - Fireworks: embeddings, cross-encoder rerank, answer generation, RAGAS judge (default)
# - Anthropic: optional; set LLM_PROVIDER=anthropic to use Claude for answer/judge
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Default LLM backend when both API keys are present: fireworks | anthropic
# LLM_PROVIDER=fireworks

# Text rerank backend: cross_encoder (default, Fireworks Qwen3 Reranker) or llm (legacy prompt rerank).
# RERANK_BACKEND=cross_encoder
# FW_CROSS_ENCODER_MODEL=accounts/fireworks/models/qwen3-reranker-8b
# Optional task hint for the reranker:
# RERANK_TASK=Given a financial 10-K filing question, retrieve the passage that best answers the query.

# If unset, defaults to DeepSeek‑V4‑Pro (`accounts/fireworks/models/deepseek-v4-pro`).
# FW_ANSWER_MODEL=accounts/fireworks/models/deepseek-v4-pro
# FW_JUDGE_MODEL=accounts/fireworks/models/qwen3-8b

# Chat model API id (Featured list shows display names — use the Model API id from the page).
# Submission needs tool/function calling + serverless (or your on-demand deployment id).
#
# Agent tool-calling (sql/rag routing). Recommended: MiniMax M2.7 on Fireworks.
# FW_AGENT_MODEL=accounts/fireworks/models/minimax-m2p7
# FW_CHAT_MODEL=accounts/fireworks/models/minimax-m2p7
# FW_SQL_MODEL=accounts/fireworks/models/minimax-m2p7
# FW_ROUTER_MODEL=accounts/fireworks/models/minimax-m2p7
#
# Other Featured options (verify on model page before uncommenting):
# FW_CHAT_MODEL=accounts/fireworks/models/deepseek-v4-pro    # frontier, FC, 1M context
# FW_CHAT_MODEL=accounts/fireworks/models/qwen3p6-plus       # flagship, FC
# FW_CHAT_MODEL=accounts/fireworks/models/gpt-oss-20b         # FC, cheapest serverless OSS in list
#
# Anthropic (only when LLM_PROVIDER=anthropic):
# ANTHROPIC_API_KEY=...
# ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_ANSWER_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5-20251001
#
# Legacy LLM rerank (only when RERANK_BACKEND=llm):
# ANTHROPIC_RERANK_MODEL=claude-haiku-4-5-20251001
#
# Optional: smaller/faster model for text-chunk rerank on Fireworks when RERANK_BACKEND=llm.
# FW_RERANK_MODEL=accounts/fireworks/models/qwen3-8b
#
# Optional: HTTP API bind (`python submission_fast/server.py`). Defaults **0.0.0.0:8000**.
# HOST=127.0.0.1
# PORT=8001

# LangSmith — LangChain agent traces (LLM + tool steps). UI Tool steps tab unchanged.
# Set API key to enable; optional project name (default fireworks-agentic-rag).
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=fireworks-agentic-rag
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Agent send_email tool (Chunk Studio / main LangChain agent)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=you@gmail.com
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
# SMTP_USE_TLS=true

