.DS_Store

# Local environment and secrets
.env
.env.*
!.env.example
.venv/
agentic-rag-takehome-fw/.venv*/

# Python caches
__pycache__/
*.py[cod]

# Local analysis / indexing caches
.codeatlas/

# Generated scratch outputs
agentic-rag-takehome-fw/scripts/output/

# Local-only MCP entrypoint (not part of repo deliverable)
agentic-rag-takehome-fw/financial_research_mcp.py

# Legacy deploy mirror; use repo root layout instead
agentic-rag-takehome-fw/_streamlit_deploy_repo/

# Nested benchmark virtualenvs are large and reproducible
agentic-rag-takehome-fw/benchmarks/**/.venv*/
agentic-rag-takehome-fw/benchmarks/**/.deps/

# Runtime / regenerable local state
agentic-rag-takehome-fw/data/agent_memory.db
agentic-rag-takehome-fw/data/chunk_studio/

# Local logs and eval artifacts
agentic-rag-takehome-fw/**/*.log
agentic-rag-takehome-fw/**/agent_log.jsonl
agentic-rag-takehome-fw/**/sql_log.jsonl
